# Lấy API Key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model mặc định theo yêu cầu ban đầu là gemini-1.5-flash.
# LƯU Ý QUAN TRỌNG: Google đã ngừng hỗ trợ (shut down) gemini-1.5-flash từ 29/09/2025.
# Nếu API báo lỗi 404 (model not found), hãy đổi sang model Flash mới đang hoạt động,
# ví dụ: gemini-flash-latest hoặc gemini-3.8-flash (hoặc gemini-3.7-flash).
GEMINI_MODEL=gemini-1.5-flash
